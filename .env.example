# Copy to .env and fill in. Never commit .env (it is git-ignored).

# ---- Mode ----
# HALO_OFFLINE=1 forces offline mode (same as POST /api/v1/admin/mode {"mode":"offline"}).
HALO_OFFLINE=0
# Mission clock origin for the QR demo CSV (AGENTS.md §5).
HALO_MISSION_START=2026-11-15T00:00:00Z
# Where SOS session logs (.jsonl) and exports (.json) go. Default: data/sos_sessions/
# HALO_SOS_LOG_DIR=

# ---- SOS alerts (AGENTS.md §8.4) ----
# dry_run (default): log what would be sent, call nothing.  live: send a real SMS via Twilio.
ALERT_MODE=dry_run
# Live mode only. Install the SDK with: uv sync --extra alert
# Twilio trial accounts can only send to numbers verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The only recipient. Never taken from a request.
MISSION_SUPPORT_NUMBER=
# Phase 3 (voice call, SMS ACK replies, status callbacks): public URL Twilio can reach.
# PUBLIC_BASE_URL=

# ---- LLM shell (AGENTS.md §10) ----
# Claude via the official SDK: uv sync --extra llm. Empty provider or key = no LLM: classify falls back to the
# picker, ask returns the fixed reply. Smoke test: uv run --env-file .env python -m halo_agent.shell.llm
HALO_LLM_PROVIDER=anthropic
HALO_LLM_API_KEY=
HALO_LLM_MODEL=claude-opus-5-5
# low (default) | medium | high | xhigh | max. classify/ask are short tasks with an 8 s budget.
HALO_LLM_EFFORT=low
HALO_LLM_TIMEOUT_S=8
